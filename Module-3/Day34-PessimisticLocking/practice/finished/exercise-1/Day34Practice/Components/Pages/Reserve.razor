@page "/reserve"
@using BYSResults
@using Day34Practice.Models
@using Day34Practice.Services
@inject ReservationService ReservationSvc

<PageTitle>Reserve Stock</PageTitle>
<h2>Practice 1: Basic Pessimistic Lock</h2>
<p>Tests your <code>ReserveAsync</code> method — basic stock reservation with a pessimistic row-level lock (UPDLOCK, ROWLOCK).</p>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label" for="product">Product:</label>
        <select id="product" class="form-select" @bind="_selectedProductId">
            @foreach (var p in _products)
            {
                <option value="@p.Id">@p.Name (Stock: @p.StockQuantity)</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="quantity">Quantity:</label>
        <input id="quantity" type="number" class="form-control" min="1" @bind="_quantity" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-primary" @onclick="ReserveStock" disabled="@_isProcessing">
            @(_isProcessing ? "Reserving..." : "Reserve")
        </button>
    </div>
</div>

@if (_result is not null)
{
    @if (_result.IsSuccess)
    {
        <div class="alert alert-success">
            Reserved successfully! Remaining stock for "@(_result.Value!.Name)":
            @_result.Value!.StockQuantity units.
        </div>
    }
    else
    {
        @foreach (var error in _result.Errors)
        {
            <div class="alert alert-danger">
                <strong>@error.Code:</strong> @error.Message
            </div>
        }
    }
}

<hr class="my-4" />
<h4>Current Inventory</h4>
<button class="btn btn-outline-secondary btn-sm mb-2" @onclick="RefreshProducts">Refresh</button>

@if (_products.Any())
{
    <table class="table table-sm table-striped">
        <thead>
            <tr><th>ID</th><th>Name</th><th>Price</th><th>Stock</th></tr>
        </thead>
        <tbody>
            @foreach (var p in _products)
            {
                <tr><td>@p.Id</td><td>@p.Name</td><td>@p.Price.ToString("C")</td><td>@p.StockQuantity</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private int _selectedProductId = 1;
    private int _quantity = 1;
    private bool _isProcessing;
    private Result<Product>? _result;
    private List<Product> _products = [];

    protected override async Task OnInitializedAsync()
    {
        _products = await ReservationSvc.GetProductsAsync();
    }

    private async Task ReserveStock()
    {
        _isProcessing = true;
        _result = null;
        StateHasChanged();

        _result = await ReservationSvc.ReserveAsync(_selectedProductId, _quantity);

        _products = await ReservationSvc.GetProductsAsync();
        _isProcessing = false;
    }

    private async Task RefreshProducts()
    {
        _products = await ReservationSvc.GetProductsAsync();
    }
}
