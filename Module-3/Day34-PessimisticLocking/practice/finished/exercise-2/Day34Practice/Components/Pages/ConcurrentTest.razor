@page "/concurrent-test"
@using BYSResults
@using Day34Practice.Models
@using Day34Practice.Utilities
@inject ConcurrentRequestSimulator Simulator

<PageTitle>Concurrent Test</PageTitle>
<h2>Practice 2: Concurrent Reservation Test</h2>
<p>Tests your <code>ReserveWithTimeoutAsync</code> method via the pre-built simulator.
Two requests run concurrently, each with its own DbContext and transaction.</p>

<div class="row mb-3">
    <div class="col-md-3">
        <label class="form-label" for="productId">Product ID:</label>
        <input id="productId" type="number" class="form-control" min="1" max="10" @bind="_productId" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="quantityA">Request A Quantity:</label>
        <input id="quantityA" type="number" class="form-control" min="1" @bind="_quantityA" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="quantityB">Request B Quantity:</label>
        <input id="quantityB" type="number" class="form-control" min="1" @bind="_quantityB" />
    </div>
</div>

<button class="btn btn-danger" @onclick="RunSimulation" disabled="@_isRunning">
    @(_isRunning ? "Running..." : "Simulate Concurrent Reservations")
</button>

@if (_log.Count > 0)
{
    <div class="mt-3">
        <h4>Simulation Log</h4>
        <ul class="list-group">
            @foreach (var entry in _log)
            {
                <li class="list-group-item @GetLogClass(entry)">
                    <code>@entry</code>
                </li>
            }
        </ul>
    </div>
}

@if (_resultA is not null && _resultB is not null)
{
    <div class="row mt-3">
        <div class="col-md-6">
            <div class="card @(_resultA.IsSuccess ? "border-success" : "border-danger")">
                <div class="card-header">Request A</div>
                <div class="card-body">
                    @if (_resultA.IsSuccess)
                    {
                        <p class="text-success">Reserved successfully.
                            Remaining: @_resultA.Value!.StockQuantity</p>
                    }
                    else
                    {
                        @foreach (var error in _resultA.Errors)
                        {
                            <p class="text-danger"><strong>@error.Code:</strong> @error.Message</p>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card @(_resultB.IsSuccess ? "border-success" : "border-danger")">
                <div class="card-header">Request B</div>
                <div class="card-body">
                    @if (_resultB.IsSuccess)
                    {
                        <p class="text-success">Reserved successfully.
                            Remaining: @_resultB.Value!.StockQuantity</p>
                    }
                    else
                    {
                        @foreach (var error in _resultB.Errors)
                        {
                            <p class="text-danger"><strong>@error.Code:</strong> @error.Message</p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int _productId = 1;
    private int _quantityA = 3;
    private int _quantityB = 3;
    private bool _isRunning;
    private List<string> _log = [];
    private Result<Product>? _resultA;
    private Result<Product>? _resultB;

    private async Task RunSimulation()
    {
        _isRunning = true;
        _log = [];
        _resultA = null;
        _resultB = null;
        StateHasChanged();

        var (resultA, resultB, log) = await Simulator
            .SimulateConcurrentReservationsAsync(_productId, _quantityA, _quantityB);

        _resultA = resultA;
        _resultB = resultB;
        _log = log;
        _isRunning = false;
    }

    private static string GetLogClass(string entry)
    {
        if (entry.Contains("ERROR") || entry.Contains("TIMEOUT") || entry.Contains("INSUFFICIENT"))
            return "list-group-item-danger";
        if (entry.Contains("SUCCESS"))
            return "list-group-item-success";
        if (entry.Contains("---"))
            return "list-group-item-secondary";
        return "";
    }
}
