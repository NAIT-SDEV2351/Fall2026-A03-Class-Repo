@page "/inventory"
@using Day34Demo.Models
@using Day34Demo.Services
@inject InventoryService InventorySvc

<PageTitle>Inventory</PageTitle>
<h2>Product Inventory</h2>
<p>Current stock levels for all products.</p>

<button class="btn btn-secondary mb-3" @onclick="RefreshProducts">Refresh</button>

@if (_products.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _products)
            {
                <tr class="@(p.StockQuantity <= 5 ? "table-warning" : "")">
                    <td>@p.Id</td>
                    <td>@p.Name</td>
                    <td>@p.Price.ToString("C")</td>
                    <td>@p.StockQuantity</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Loading products...</p>
}

@code {
    private List<Product> _products = [];

    protected override async Task OnInitializedAsync()
    {
        _products = await InventorySvc.GetProductsAsync();
    }

    private async Task RefreshProducts()
    {
        _products = await InventorySvc.GetProductsAsync();
    }
}
