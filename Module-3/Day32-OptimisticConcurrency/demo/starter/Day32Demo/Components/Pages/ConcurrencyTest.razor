@page "/concurrency-test"
@using Day32Demo.Utilities
@inject ConcurrencySimulator Simulator

<PageTitle>Concurrency Test</PageTitle>
<h2>Concurrency Conflict Simulator</h2>
<p>Simulates two users editing the same product with separate DbContext instances.</p>

<div class="mb-3">
    <label>Product ID: <input type="number" @bind="_productId" /></label>
</div>

<button class="btn btn-danger" @onclick="RunSimulation">Simulate Conflict</button>

@if (_log.Count > 0)
{
    <div class="mt-3">
        <h4>Simulation Log</h4>
        <ul class="list-group">
            @foreach (var entry in _log)
            {
                <li class="list-group-item @(entry.Contains("Exception") ? "list-group-item-danger" : entry.Contains("SUCCESS") ? "list-group-item-success" : "")">
                    <code>@entry</code>
                </li>
            }
        </ul>
    </div>
}

@code {
    private int _productId = 1;
    private List<string> _log = [];

    private async Task RunSimulation()
    {
        _log = await Simulator.SimulateConflictAsync(_productId);
    }
}
