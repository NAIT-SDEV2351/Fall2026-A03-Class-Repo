@page "/checkout"
@using Day27Practice.Services
@inject CheckoutService CheckoutSvc

<PageTitle>Checkout</PageTitle>

<h2>Checkout (Practice 2)</h2>
<p>Implement <code>CheckoutAsync</code> in <code>Services/CheckoutService.cs</code> using an explicit transaction.</p>

<div class="mb-3">
    <label>Product ID: <input type="number" @bind="_productId" /></label>
</div>
<div class="mb-3">
    <label>Quantity: <input type="number" @bind="_quantity" /></label>
</div>
<div class="mb-3">
    <label>Customer: <input type="text" @bind="_customer" /></label>
</div>

<button class="btn btn-primary" @onclick="RunCheckout">Run Checkout</button>

@if (!string.IsNullOrEmpty(_result))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_result</div>
}

<div class="mt-3">
    <p><strong>After testing:</strong></p>
    <ul>
        <li>Check <a href="/inventory">Inventory</a> -- stock should decrease by the quantity ordered.</li>
        <li>Check <a href="/orders">Orders</a> -- a new order should appear.</li>
    </ul>
</div>

@code {
    private int _productId = 1;
    private int _quantity = 1;
    private string _customer = "Alice";
    private string? _result;
    private bool _isError;

    private async Task RunCheckout()
    {
        try
        {
            // A finished CheckoutAsync returns a Result — a validation failure or a rolled-back
            // failure is a handled result. The catch below is a safety net while you build it.
            var result = await CheckoutSvc.CheckoutAsync(_productId, _quantity, _customer);
            _isError = !result.IsSuccess;
            _result = result.IsSuccess ? result.Value : result.FirstError?.Message;
        }
        catch (Exception ex)
        {
            _result = $"Exception: {ex.Message}";
            _isError = true;
        }
    }
}
