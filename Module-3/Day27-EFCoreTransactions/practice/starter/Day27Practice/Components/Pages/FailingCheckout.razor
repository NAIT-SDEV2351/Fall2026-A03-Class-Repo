@page "/failing-checkout"
@using Day27Practice.Services
@inject CheckoutService CheckoutSvc

<PageTitle>Failing Checkout</PageTitle>

<h2>Failing Checkout (Practice 3)</h2>
<p>Implement <code>FailingCheckoutAsync</code> -- copy your working checkout, then throw an exception after the <code>SaveChangesAsync</code> but before the <code>CommitAsync</code>. The rollback should undo the write completely.</p>

<div class="mb-3">
    <label>Product ID: <input type="number" @bind="_productId" /></label>
</div>
<div class="mb-3">
    <label>Quantity: <input type="number" @bind="_quantity" /></label>
</div>
<div class="mb-3">
    <label>Customer: <input type="text" @bind="_customer" /></label>
</div>

<button class="btn btn-warning" @onclick="RunFailingCheckout">Run Failing Checkout</button>

@if (!string.IsNullOrEmpty(_result))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_result</div>
}

<div class="mt-3">
    <p><strong>After testing:</strong></p>
    <ul>
        <li>Check <a href="/inventory">Inventory</a> -- stock should be <strong>unchanged</strong> (rollback worked).</li>
        <li>Check <a href="/orders">Orders</a> -- <strong>no orphaned order</strong> should appear.</li>
    </ul>
</div>

@code {
    private int _productId = 1;
    private int _quantity = 2;
    private string _customer = "Bob";
    private string? _result;
    private bool _isError;

    private async Task RunFailingCheckout()
    {
        try
        {
            // FailingCheckoutAsync returns a Result — the simulated failure rolls back and
            // comes back as a handled failure. The catch below is a safety net while you build it.
            var result = await CheckoutSvc.FailingCheckoutAsync(_productId, _quantity, _customer);
            _isError = !result.IsSuccess;
            _result = result.IsSuccess ? result.Value : result.FirstError?.Message;
        }
        catch (Exception ex)
        {
            _result = $"Exception: {ex.Message}";
            _isError = true;
        }
    }
}
