@page "/add-product"
@using Day27Practice.Services
@inject ProductService ProductSvc

<PageTitle>Add Product</PageTitle>

<h2>Add Product (Practice 1)</h2>
<p>Test implicit transactions by adding products with audit logging.</p>

<div class="mb-3">
    <label>Product Name: <input type="text" @bind="_name" /></label>
</div>
<div class="mb-3">
    <label>Price: <input type="number" step="0.01" @bind="_price" /></label>
</div>
<div class="mb-3">
    <label>Stock Quantity: <input type="number" @bind="_stock" /></label>
</div>

<div class="mb-3">
    <button class="btn btn-success me-2" @onclick="RunWorkingAdd">
        Add with Audit (Working)
    </button>
    <button class="btn btn-danger" @onclick="RunBrokenAdd">
        Add with Broken Audit (Fails)
    </button>
</div>

@if (!string.IsNullOrEmpty(_result))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_result</div>
}

<div class="mt-3">
    <p><strong>After testing:</strong> Go to <a href="/inventory">Inventory</a> to see the results.</p>
    <ul>
        <li><strong>Working:</strong> Product added AND audit log created (single SaveChanges).</li>
        <li><strong>Broken:</strong> Product added BUT no audit log -- the exception happens after the first SaveChanges.</li>
    </ul>
</div>

@code {
    private string _name = "Webcam";
    private decimal _price = 89.99m;
    private int _stock = 20;
    private string? _result;
    private bool _isError;

    private async Task RunWorkingAdd()
    {
        try
        {
            _result = await ProductSvc.AddProductWithAuditAsync(_name, _price, _stock);
            _isError = false;
        }
        catch (Exception ex)
        {
            _result = $"Exception: {ex.Message}";
            _isError = true;
        }
    }

    private async Task RunBrokenAdd()
    {
        try
        {
            _result = await ProductSvc.AddProductWithBrokenAuditAsync(_name, _price, _stock);
            _isError = false;
        }
        catch (Exception ex)
        {
            _result = $"Exception: {ex.Message}";
            _isError = true;
        }
    }
}
