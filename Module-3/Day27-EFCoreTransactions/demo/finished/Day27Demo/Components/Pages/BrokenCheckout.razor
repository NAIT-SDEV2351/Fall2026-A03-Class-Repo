@page "/broken-checkout"
@using Day27Demo.Services
@inject CheckoutService Checkout

<PageTitle>Broken Checkout</PageTitle>

<h2>Broken Checkout (Day 26 Bug)</h2>
<p>Two SaveChangesAsync calls without a transaction. Step 1 commits independently.</p>

<div class="mb-3">
    <label>Product ID: <input type="number" @bind="_productId" /></label>
</div>
<div class="mb-3">
    <label>Quantity: <input type="number" @bind="_quantity" /></label>
</div>
<div class="mb-3">
    <label>Customer: <input type="text" @bind="_customer" /></label>
</div>

<button class="btn btn-danger" @onclick="RunBrokenCheckout">Run Broken Checkout</button>

@if (!string.IsNullOrEmpty(_result))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_result</div>
}

@code {
    private int _productId = 1;
    private int _quantity = 1;
    private string _customer = "Alice";
    private string? _result;
    private bool _isError;

    private async Task RunBrokenCheckout()
    {
        try
        {
            // A handled outcome (validation, declined payment) comes back as a Result.
            var result = await Checkout.BrokenCheckoutAsync(_productId, _quantity, _customer);
            _isError = !result.IsSuccess;
            _result = result.IsSuccess ? result.Value : result.FirstError?.Message;
        }
        catch (Exception ex)
        {
            // The simulated crash between the charge and the order write is UNCONTROLLED — it
            // surfaces as an exception. Inventory is already gone and the card was charged, but
            // no order exists and there is no transaction to undo any of it.
            _result = $"Exception: {ex.Message}";
            _isError = true;
        }
    }
}
