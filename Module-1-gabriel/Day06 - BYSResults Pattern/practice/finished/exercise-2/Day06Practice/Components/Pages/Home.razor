                <a href="/account" class="btn btn-outline-primary mt-2 d-block">Go to Account</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Practice 2: Service Refactor</h5>
                <p class="card-text">Convert a service from exception-throwing to Result&lt;T&gt;.</p>
                <span class="badge bg-success">Independent -- 25 min</span>
                <a href="/products" class="btn btn-outline-success mt-2 d-block">Go to Products</a>
            </div>
        </div>
    </div>
