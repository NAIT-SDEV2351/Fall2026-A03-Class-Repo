@page "/"

<PageTitle>Day 6 Practice</PageTitle>

<h1>Day 6 Practice: Centralized State and BYSResult Pattern</h1>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Practice 1: Account Overview Wiring</h5>
                <p class="card-text">Wire three pre-built cards to a shared Fluxor store.</p>
