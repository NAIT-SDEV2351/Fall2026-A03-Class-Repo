@* Route constraints reject non-matching URLs with a 404 before the page renders:
   :alpha = letters only, :int:min(1) = integer ≥ 1. The Test URLs table shows what passes/fails. *@
@page "/products/{category:alpha}/{id:int:min(1)}"

<PageTitle>@Category - Product @Id</PageTitle>

<h1>Product Detail</h1>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">@Category -- Product #@Id</h5>
        <p class="card-text">
            This page demonstrates <strong>multiple route parameters</strong> with constraints.
            The route <code>/products/{"{category:alpha}/{id:int:min(1)}"}</code> requires:
        </p>
        <ul>
            <li><strong>category</strong> -- must be alphabetic characters only (<code>:alpha</code>)</li>
            <li><strong>id</strong> -- must be a positive integer (<code>:int:min(1)</code>)</li>
        </ul>

        <h6 class="mt-3">Test URLs:</h6>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>URL</th>
                    <th>Result</th>
                    <th>Why</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>/products/electronics/42</code></td>
                    <td><span class="text-success">Match</span></td>
                    <td>Alpha string + positive integer</td>
                </tr>
                <tr>
                    <td><code>/products/home-garden/42</code></td>
                    <td><span class="text-danger">404</span></td>
                    <td>Hyphen is not alphabetic</td>
                </tr>
                <tr>
                    <td><code>/products/electronics/0</code></td>
                    <td><span class="text-danger">404</span></td>
                    <td>Fails min(1) constraint</td>
                </tr>
                <tr>
                    <td><code>/products/electronics/-5</code></td>
                    <td><span class="text-danger">404</span></td>
                    <td>Fails min(1) constraint</td>
                </tr>
                <tr>
                    <td><code>/products/123/42</code></td>
                    <td><span class="text-danger">404</span></td>
                    <td>Digits are not alpha</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    // [Parameter] binds a route token to a property by name: {category} → Category,
    // {id} → Id (already typed as int via the :int constraint).
    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public int Id { get; set; }
}
