@page "/counter"
@inherits FluxorComponent
@inject IState<Day04Practice.Features.Counter.Store.CounterState> CounterState
@inject IDispatcher Dispatcher

<PageTitle>Practice 1: Counter</PageTitle>

<h1>Practice 1: Counter Store</h1>

<p class="lead">Current count: <strong>@CounterState.Value.Count</strong></p>

<div class="btn-group" role="group">
    <button class="btn btn-success" @onclick="Increment">+ Increment</button>
    <button class="btn btn-danger" @onclick="Decrement">- Decrement</button>
    <button class="btn btn-warning" @onclick="Reset">Reset</button>
</div>

@if (CounterState.Value.Count == 0)
{
    <div class="alert alert-info mt-3">
        Counter is at zero. Try incrementing!
    </div>
}

@code {
    private void Increment()
    {
        Dispatcher.Dispatch(new Day04Practice.Features.Counter.Store.IncrementCounterAction());
    }

    private void Decrement()
    {
        Dispatcher.Dispatch(new Day04Practice.Features.Counter.Store.DecrementCounterAction());
    }

    private void Reset()
    {
        Dispatcher.Dispatch(new Day04Practice.Features.Counter.Store.ResetCounterAction());
    }
}
