@page "/admin/dashboard"
@layout AdminLayout
<PageTitle>Admin Dashboard</PageTitle>

<h1>Admin Dashboard</h1>

<p>Welcome to the admin area. This page renders inside the <strong>AdminLayout</strong>, which renders inside <strong>MainLayout</strong>.</p>

<div class="row mt-3">
    <div class="col-md-4">
        <div class="card text-bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Users</h5>
                <p class="card-text display-6">42</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Active Sessions</h5>
                <p class="card-text display-6">18</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Reports</h5>
                <p class="card-text display-6">7</p>
            </div>
        </div>
    </div>
</div>
