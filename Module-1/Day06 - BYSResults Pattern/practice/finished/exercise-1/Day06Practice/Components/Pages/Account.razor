@page "/account"
@using Fluxor
@inject IDispatcher Dispatcher

<PageTitle>Practice 1: Account Overview</PageTitle>

<h1>Practice 1: Account Overview Component Wiring</h1>
<p class="text-muted">
    Three cards wired to the shared <code>AccountState</code> store.
</p>

<div class="alert alert-success">
    <strong>Complete!</strong> All three cards subscribe to the same Fluxor store slice.
    One action dispatched, three cards updated.
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <OrdersCard />
    </div>
    <div class="col-md-4">
        <WishlistCard />
    </div>
    <div class="col-md-4">
        <MembershipCard />
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // One dispatch on load → the effect fills the store → all three subscribed
        // cards re-render from the same slice. That shared-slice update is the
        // whole point of this practice.
        Dispatcher.Dispatch(new LoadAccountAction());
    }
}
