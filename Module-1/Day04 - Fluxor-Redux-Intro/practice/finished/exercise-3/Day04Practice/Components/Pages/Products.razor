@page "/products"
@inherits FluxorComponent
@inject IState<Day04Practice.Features.Cart.Store.CartState> CartState
@inject IDispatcher Dispatcher

<PageTitle>Practice 3: Products</PageTitle>

<h1>Practice 3: Products</h1>

<p>Browse products and add them to your cart. Navigate to the Cart page to verify state persists.</p>

<div class="row">
    @foreach (var product in availableProducts)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Price.ToString("C")</p>
                    <button class="btn btn-primary" @onclick="() => AddToCart(product)">
                        Add to Cart
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<div class="alert alert-success mt-3">
    <strong>Cart total:</strong> @CartState.Value.TotalItems item(s) --
    @CartState.Value.TotalPrice.ToString("C")
</div>

@code {
    private readonly List<Day04Practice.Features.Cart.Models.CartProduct> availableProducts =
    [
        new(1, "Wireless Mouse", 29.99m),
        new(2, "USB-C Hub", 49.99m),
        new(3, "Mechanical Keyboard", 89.99m)
    ];

    private void AddToCart(Day04Practice.Features.Cart.Models.CartProduct product)
    {
        Dispatcher.Dispatch(
            new Day04Practice.Features.Cart.Store.AddToCartAction(
                product.Id, product.Name, product.Price));
    }
}
