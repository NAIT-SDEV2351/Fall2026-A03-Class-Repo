@page "/returns/start/{orderId:int:min(1)}"
@inject NavigationManager Navigation

<PageTitle>Returns - Start</PageTitle>

<h1>Product Return</h1>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Start a Return for Order #@OrderId</h5>

        <p class="card-text">
            We're sorry to hear you'd like to return an item from this order.
            Click below to begin the return process.
        </p>

        <button class="btn btn-primary" @onclick="StartReturn">
            Start Return Process &rarr;
        </button>
    </div>
</div>

@code {
    // OrderId is captured from the route, then THREADED into the next step's URL. With no
    // shared state yet, the URL itself is what carries order context forward through the flow.
    [Parameter] public int OrderId { get; set; }

    private void StartReturn()
    {
        Navigation.NavigateTo($"/returns/reason/{OrderId}");
    }
}
