@page "/checkout/shipping"
@inject NavigationManager Navigation

<PageTitle>Checkout - Shipping</PageTitle>

<h1>Checkout: Shipping</h1>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Step 1 of 3: Shipping Information</h5>

        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" class="form-control" placeholder="Jane Smith" />
        </div>
        <div class="mb-3">
            <label class="form-label">Address</label>
            <input type="text" class="form-control" placeholder="123 Main St" />
        </div>
        <div class="mb-3">
            <label class="form-label">City</label>
            <input type="text" class="form-control" placeholder="Edmonton" />
        </div>

        <button class="btn btn-primary" @onclick="ContinueToPayment">
            Continue to Payment &rarr;
        </button>
    </div>
</div>

@code {
    // Each wizard step advances by CODE, not a link click: the button handler calls NavigateTo().
    // Because the component drives the flow (shipping → payment → confirm), a step could later
    // gate the move on form validation before navigating.
    private void ContinueToPayment()
    {
        Navigation.NavigateTo("/checkout/payment");
    }
}
