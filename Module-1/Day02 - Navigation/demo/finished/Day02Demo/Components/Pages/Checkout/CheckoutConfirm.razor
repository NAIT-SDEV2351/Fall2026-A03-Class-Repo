@page "/checkout/confirm"
@inject NavigationManager Navigation

<PageTitle>Checkout - Confirmation</PageTitle>

<h1>Checkout: Confirmation</h1>

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Step 3 of 3: Review Your Order</h5>

        <div class="alert alert-success">
            Order ready for submission. In a real application, this page would display
            the shipping and payment details collected in steps 1 and 2.
        </div>

        <p>
            <strong>Key takeaway:</strong> Each step used <code>NavigateTo()</code> to advance
            the user through the wizard. The code decided where to go next -- not a link click.
        </p>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="GoBack">
                &larr; Back to Payment
            </button>
            <button class="btn btn-success" @onclick="StartOver">
                Start Over
            </button>
        </div>

        <p class="text-muted mt-2">
            <small>The Back button uses <code>replace: true</code> so the browser's back button
            skips the confirmation page and returns directly to payment.</small>
        </p>
    </div>
</div>

@code {
    // replace: true — same reasoning as the payment step: returning to payment shouldn't leave
    // a confirmation entry the browser Back button could re-land on.
    private void GoBack()
    {
        Navigation.NavigateTo("/checkout/payment", replace: true);
    }

    private void StartOver()
    {
        // Deliberately NO replace: true — the contrast with the Back buttons. Starting over
        // PUSHES a fresh Shipping entry, so the user can press browser Back to return here.
        Navigation.NavigateTo("/checkout/shipping");
    }
}
